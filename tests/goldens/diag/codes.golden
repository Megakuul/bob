# bob error code table (SPEC §02.3). Generated by go test ./pkg/bob/diag -update.

BOB-E-0001 usage - exit=2
  message: unknown {kind} "{name}"
  hint:    did you mean {suggest}?
  hint:    run bob help

BOB-E-0002 usage - exit=2
  message: not inside a bob repository (no bob.lock in {dir} or any parent)
  hint:    run bob from your project, or use -C <dir>

BOB-E-0003 usage - exit=2
  message: pattern {pattern} matches no package
  hint:    run bob graph to list packages

BOB-E-0004 usage - exit=2
  message: {flag} needs {what}

BOB-E-0005 usage - exit=2
  message: {label} is not runnable
  hint:    bob run needs a binary package

BOB-E-0006 usage - exit=2
  message: {label} does not support {platform} (it allows: {platforms})
  hint:    pick a supported platform, or build without --platform

BOB-E-0007 usage - exit=2
  message: variants "{a}" and "{b}" conflict: {reason}
  hint:    drop one of them

BOB-E-0008 usage - exit=2
  message: unsupported host architecture "{arch}" (bob runs on linux-amd64 and linux-arm64)

BOB-E-0009 usage - exit=2
  message: {ref} has nothing to install (it contains: {kinds}); download its artifacts from {url}

BOB-E-0010 usage - exit=2
  message: unknown platform "{platform}" (known: {known})

BOB-E-0011 usage - exit=2
  message: {label}: {ecosystem} packages cannot be cross-compiled yet (requested {platform} on a {host} host)
  hint:    build for the host platform, or use an ecosystem that supports cross-compilation

BOB-E-1001 definition - exit=3
  message: nixpkgs has no package "{attr}"
  hint:    did you mean {suggest}?

BOB-E-1001 definition pin exit=3
  message: {pos}: nixpkgs at the pinned revision {rev} has no package "{attr}" (nixpkgs.{name})
  hint:    bob's typed nixpkgs packages come from {surface}; move the pin with bob lock --update nixpkgs, or use another package

BOB-E-1002 definition - exit=3
  message: nixpkgs package "{attr}" ({version}) is marked broken
  hint:    pin a nixpkgs revision where it builds, or use another package

BOB-E-1003 definition - exit=3
  message: nixpkgs package "{attr}" ({version}) is marked insecure: {cves}
  hint:    use a fixed version; bob refuses known-vulnerable packages unless allowed per package

BOB-E-1004 definition - exit=3
  message: nixpkgs package "{attr}" has an unfree licence
  hint:    allow it explicitly for this package if your licence permits

BOB-E-1005 definition - exit=3
  message: nixpkgs package "{attr}" is not available for {system}

BOB-E-1006 definition - exit=3
  message: dependency cycle: {cycle}
  hint:    a package cannot depend on itself; move the shared code into its own package

BOB-E-1007 definition - exit=3
  message: {label} depends on unknown package {dep}

BOB-E-1008 definition - exit=3
  message: {label} needs Go {want} but nixpkgs {rev} provides Go {have}
  hint:    lower GoVersion or pin a newer nixpkgs

BOB-E-1008 definition requirement exit=3
  message: {requirement} needs go {need}, but {module} uses go {go} (set Go in {file})
  hint:    raise the module's Go, or require an older {requirement}

BOB-E-1009 definition - exit=3
  message: {label} has no pinned hash in bob.lock
  hint:    run bob lock

BOB-E-1010 definition - exit=3
  message: {label} targets {system}, which this machine cannot build
  hint:    build it remotely (bob build --remote) or for this machine's platform

BOB-E-1011 definition - exit=3
  message: generated file {file} was edited by hand
  hint:    move the change into bob.go; bob check --fix regenerates the file

BOB-E-1012 definition - exit=3
  message: bob.lock is out of date: {what}
  hint:    run bob lock

BOB-E-1013 definition - exit=3
  message: {path} is not ignored by git
  hint:    bob check --fix adds it to bob's block in .git/info/exclude

BOB-E-1014 definition - exit=3
  message: no dev shell "{name}" (have: {names})

BOB-E-1015 definition - exit=3
  message: cannot resolve {ecosystem} dependencies for {root}: {reason}
  hint:    relax the conflicting requirement named above

BOB-E-1016 definition - exit=3
  message: {path} conflicts with generated output of {label}: {reason}
  hint:    move or delete the file, or run bob gen --force (keeps a backup)

BOB-E-1017 definition - exit=3
  message: nixpkgs package "{attr}" cannot be evaluated on {system}
  hint:    pin another nixpkgs revision or use another package

BOB-E-1018 definition - exit=3
  message: evaluating bob.go is not deterministic: {label}
  hint:    bob.go must not depend on time, randomness, environment or map order

BOB-E-1019 definition - exit=3
  message: bob.lock cannot be read: {reason} (line {line})
  hint:    resolve the merge conflict, or run bob lock --rebuild to resolve everything again from bob.go

BOB-E-1020 definition - exit=3
  message: {label}: invalid {option}: {reason}
  hint:    {hint}

BOB-E-1021 definition - exit=3
  message: {label}: toolchain mismatch: {reason}
  hint:    align the versions named above

BOB-E-1022 definition - exit=3
  message: {label} is not a static binary (it needs {deps})
  hint:    use tarball.Closure

BOB-E-1023 definition - exit=3
  message: {package} cannot be pinned: {reason}

BOB-E-1024 definition R1 exit=3
  message: {dir}/bob.go: the first line must be "//go:build bob" so that go build, go vet and go test ignore it

BOB-E-1024 definition R2 exit=3
  message: {dir}/bob.go: package {have}, but the Go code in this directory is package {want}; bob.go must use package {want}

BOB-E-1024 definition R3 exit=3
  message: {dir}/bob.go: imports the build definitions of {maindir}/, which is a main package and cannot be imported; define the shared package in a bob.go of a non-main directory

BOB-E-1024 definition R4 exit=3
  message: {dir}/bob.go:{line}: {name} is also declared at {file}:{fileline}; bob.go shares its package with that code, rename one of them

BOB-E-1024 definition R6 exit=3
  message: {dir}/bob.go imports {dir2}, whose Go code imports {dir} (cycle exists only for build definitions); move the definition

BOB-E-1024 definition R7 exit=3
  message: {dir}/bob.go: imports {path}, which build definitions cannot use; bob.go may import the bob framework, the standard library and other bob.go packages

BOB-E-1024 definition R8 exit=3
  message: {dir}/bob.go:{line}: assigns to {name}, a value of the bob framework; framework values are read-only, declare your own variable

BOB-E-1025 definition outside exit=3
  message: {pos}: source pattern "{pattern}" leaves the repository

BOB-E-1025 definition noglob exit=3
  message: {pos}: bob.Glob("{pattern}") matches no files

BOB-E-1025 definition symlink exit=3
  message: {file}: symlink points outside the repository

BOB-E-1026 definition - exit=3
  message: nixpkgs mismatch: {what}
  hint:    {hint}

BOB-E-1028 definition outside exit=3
  message: {pos}: {label}: "{pattern}" leaves the package directory {dir}/
  hint:    each bob.go builds only the files below its own directory; give the other directory its own bob.go and depend on its package

BOB-E-1028 definition subpackage exit=3
  message: {pos}: {label}: "{pattern}" is inside {sub}/, which has its own bob.go
  hint:    use the package defined in {sub}/bob.go through its handle

BOB-E-1029 definition - exit=3
  message: {pos}: {label}: {dir}/bob.go already defines the {ecosystem} {kind} {other} at {pos2}; one library or binary per directory package
  hint:    move {label} into its own directory with its own bob.go and depend on it through its handle

BOB-E-2000 build - exit=1
  message: {label} failed to build

BOB-E-2001 build - exit=1
  message: {label}: compile error in {file}

BOB-E-2002 build - exit=1
  message: {label}: undefined symbol {symbol}
  hint:    the symbol is not provided by any linked library; a dependency is probably missing from Deps

BOB-E-2003 build - exit=1
  message: {label}: header {header} not found
  hint:    add the package that provides {header} to Deps

BOB-E-2004 build - exit=1
  message: {label}: library {lib} not found
  hint:    add the package that provides lib{lib} to Deps, or remove the link flag

BOB-E-2005 build - exit=1
  message: {label}: tests failed
  hint:    run bob test {label} -v to see the full test output

BOB-E-2006 build - exit=1
  message: {label}: dependency {module} needs Go {want} (toolchain is Go {have})
  hint:    use an older version of {module} or pin a newer nixpkgs

BOB-E-2007 build - exit=1
  message: {label} timed out after {seconds}s
  hint:    raise the package's timeout if the step is legitimately slow

BOB-E-2008 build - exit=1
  message: {label} produced no output for {seconds}s and was stopped
  hint:    a step is probably waiting for input or hanging

BOB-E-2009 build - exit=1
  message: {label} tried to use the network during the build
  hint:    builds are offline; declare the download as a fetched dependency so bob.lock pins it

BOB-E-2010 build - exit=1
  message: {label}: Rust crate {crate} not found
  hint:    add the crate to the package's dependencies

BOB-E-2011 build - exit=1
  message: {label} wrote more than {bytes} bytes of log output and was stopped
  hint:    a step is printing in a loop; reduce its output or raise the log limit

BOB-E-2012 build - exit=1
  message: dev server {name} exited with status {status}
  hint:    see {log}

BOB-E-2013 build - exit=1
  message: {label}: {package} needs its {script} script ({reason})
  hint:    declare {package} (npm.Dep or npm.Indirect("{package}")) and add npm.AllowScripts(<its handle>) to {label}

BOB-E-2014 build - exit=1
  message: {label}: {package} uses {dep} without declaring it
  hint:    declare both (npm.Dep or npm.Indirect) and add npm.Extend(<handle of {package}>, npm.Peer(<handle of {dep}>))

BOB-E-2015 build - exit=1
  message: {label}: prune pattern "{pattern}" removes {file}, which {user} needs
  hint:    narrow the pattern

BOB-E-2016 build - exit=1
  message: {label}: {reason}

BOB-E-3001 fetch - exit=4
  message: {label}: download does not match bob.lock
  hint:    if the upstream file legitimately changed, run bob lock; otherwise the source was tampered with

BOB-E-3002 fetch - exit=4
  message: {label}: download failed: {reason}
  hint:    check the URL and your network; bob retried {attempts} times

BOB-E-3003 fetch - exit=4
  message: {label}: download not found (HTTP {status})
  hint:    the file was removed or the URL in bob.go is wrong

BOB-E-3004 fetch - exit=4
  message: {label}: archive {url} contains an unsafe entry {path} ({reason})
  hint:    the archive is malformed or hostile; bob refused it

BOB-E-4001 cache - exit=4
  message: cache {cache} rejected bob's credentials
  hint:    run bob login

BOB-E-4002 cache - exit=4
  message: cache {cache} lists {what} but cannot deliver it (HTTP {status})
  hint:    the cache is inconsistent; report it to the cache admin

BOB-E-4003 cache - exit=4
  message: cache {cache} is unreachable: {reason}
  hint:    bob builds locally when a cache is down

BOB-E-4004 cache - exit=4
  message: cache {cache} served {what} without a trusted signature
  hint:    the cache's signing key is not trusted; check bob registry list

BOB-E-4005 cache - exit=4
  message: cache {cache} served corrupted data for {what}
  hint:    report this to the cache admin; bob refused the download

BOB-E-4006 cache - exit=4
  message: {label} is not in any cache and local builds are disabled
  hint:    build it remotely (bob build --remote) or allow local builds

BOB-E-4007 cache - exit=4
  message: uploading {label} to the cache failed
  hint:    the build itself succeeded; the worker retries the upload

BOB-E-4008 cache - exit=4
  message: your login to {server} has expired or is invalid
  hint:    run bob login {server}

BOB-E-4009 cache none exit=4
  message: no bob server configured
  hint:    run bob login <url>

BOB-E-4009 cache unreachable exit=4
  message: bob server {server} is unreachable: {reason}
  hint:    check the URL and your network

BOB-E-4010 cache - exit=4
  message: {server} denied {action} on project {project}
  hint:    ask an admin for the permission {permission}

BOB-E-4011 cache - exit=4
  message: release {ref} not found on {registry}
  hint:    bob list --available {project} shows the versions

BOB-E-4012 cache - exit=4
  message: remote build {id} failed on the server: {reason}
  hint:    bob log --build {id}

BOB-E-5001 upstream - exit=5
  message: nixpkgs package {attr} failed to build from source (needed by {users})
  hint:    this is not your code: pin another revision or ask your bob server admin

BOB-E-6001 resource - exit=6
  message: no space left on device while building {what}
  hint:    free disk space (bob gc) or move bob's store to a larger disk

BOB-E-6002 resource - exit=6
  message: {what} was killed: out of memory
  hint:    reduce parallel jobs (bob build -j) or raise the memory limit

BOB-E-6003 resource - exit=6
  message: {what} was killed by signal {signal}
  hint:    run the build again; if it repeats, reduce parallel jobs

BOB-E-7001 store - exit=7
  message: bob's store is locked by another process
  hint:    another bob command is running

BOB-E-7002 store - exit=7
  message: bob's store is not accessible: {reason}
  hint:    bob's state directory belongs to another user or is read-only

BOB-E-7003 store - exit=7
  message: bob's store is damaged: {what}
  hint:    run bob doctor --repair

BOB-E-7004 store - exit=7
  message: bob's cache database is busy
  hint:    another bob process is using the same state directory

BOB-E-7005 store - exit=7
  message: bob cannot create its private /nix: unprivileged user namespaces are blocked on this system
  hint:    fix (run once as an administrator): {fix}

BOB-E-7006 store - exit=7
  message: shim {shim} belongs to {root}, which has no bob environment
  hint:    run bob env in {root}, or delete {shim}

BOB-E-7007 store - exit=7
  message: storage backend {endpoint} is not supported: {reason}
  hint:    bob-server needs an S3 backend with conditional writes

BOB-E-7008 store - exit=7
  message: {bucket} bucket policy is too permissive: {reason}
  hint:    apply the shipped policy

BOB-E-7009 store - exit=7
  message: the worker must run as root; builds themselves never run as root
  hint:    start bob-server worker as root

BOB-E-7010 store - exit=7
  message: worker cannot isolate builds: {reason}
  hint:    see the worker host requirements

BOB-E-8001 interrupt - exit=130
  message: build cancelled

BOB-E-9001 internal - exit=70
  message: bob's builder for {label} is broken: {reason}
  hint:    this is a bob bug; please report it with bob log {label}

BOB-E-9002 internal - exit=70
  message: {label} did not produce its output
  hint:    this is a bob bug; please report it with bob log {label}

BOB-E-9003 internal - exit=70
  message: {label} refers to {ref}, which it must not reference
  hint:    this is a bob bug (missing fixup)

BOB-E-9004 internal - exit=70
  message: bob generated an invalid build step for {label}: {reason}
  hint:    this is a bob bug; please report it with bob build -v

BOB-E-9005 internal - exit=70
  message: Nix stopped unexpectedly ({reason})
  hint:    run with -v and report it

BOB-E-9006 internal - exit=70
  message: quirks entry {entry} has no justification or passing test

BOB-E-9007 internal - exit=70
  message: embedded builder does not match its recorded hash
  hint:    this is a bob bug (stale builders.go table)

BOB-E-9008 internal - exit=70
  message: {feature} is not implemented yet

BOB-E-9998 internal - exit=70
  message: unrecognised Nix log format (Nix {nixVersion})
  hint:    bob only supports the Nix it embeds

BOB-E-9999 internal - exit=70
  message: unrecognised Nix error
  hint:    this is a bob bug; the raw message is shown with -v
